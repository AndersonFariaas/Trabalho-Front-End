{
  "name": "senai-shop",
  "private": true,
  "type": "module",
  "description": "Loja do SENAI FIRJAN integrada ao sistema de moedas da turma.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/servidor-local.js",
