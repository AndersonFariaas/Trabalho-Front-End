# Segredo para assinar o cookie de sessão do aluno (mínimo 32 caracteres, aleatório).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres

# Senha de administrador do FreeOnlineStorage (a mesma ADMIN_AUTH do painel do professor).
# Necessária se o bucket "senai" exigir o cabeçalho admin-auth para gravar. Nunca use no front.
COINS_ADMIN_AUTH=
